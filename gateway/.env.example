GATEWAY_PORT=4001
GATEWAY_RPC_URL=https://api.devnet.solana.com
# GATEWAY_WS_RPC_URL=wss://api.devnet.solana.com

PROGRAM_ID=3gGkKra1uhoDukSkFLCux8j3gkxoMdUjzMfHzLGKkyzk
IDL_PATH=../target/idl/exchange.json

GATEWAY_DB_PATH=./data/gateway.sqlite
GATEWAY_BODY_LIMIT=64kb

# comma-separated; leave empty for wildcard during local dev
GATEWAY_CORS_ORIGINS=http://localhost:3004

GATEWAY_RATE_WINDOW_MS=60000
GATEWAY_RATE_MAX=60
# per-bearer ceiling on /v1/query/* — higher than the global IP bucket
GATEWAY_RATE_MAX_AUTHED=240

GATEWAY_REPLAY_TTL_SEC=2592000
GATEWAY_ACCESS_KEY_TTL_SEC=86400
GATEWAY_SUB_CACHE_TTL_MS=7000

# Absolute path to the USDC mint authority keypair, used ONLY by
# /v1/pay-with-sol to co-sign the mintTo ix. Leave empty to disable SOL
# payments on this gateway instance.
GATEWAY_MINT_AUTHORITY_KEYPAIR_PATH=
USDC_MINT=HaSyCU2nb7ffrfepbDccqB2Q2oGin9V9YkFjjAcdpQXd

# skip on-chain log stream (useful if RPC doesn't support WS)
# GATEWAY_SKIP_STREAM=1
